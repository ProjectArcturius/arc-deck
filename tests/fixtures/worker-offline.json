{
  "schema_version": 1,
  "runtime": { "kind": "fixture-sdk", "scenario": "success" },
  "state_root": "../../target/arc-deck-worker-state",
  "authorization": {
    "workspace": "../..",
    "profile": "workspace-development",
    "read_paths": ["."],
    "write_paths": ["crates/", "agents/", "prompts/", "docs/"],
    "network": false,
    "allow_commit": false,
    "allow_push": false,
    "allowed_agents": ["echo", "build", "plan"]
  },
  "agents": {
    "dir": "../../agents",
    "prompts_dir": "../../prompts"
  },
  "timeouts": {
    "initialize_seconds": 15,
    "prompt_seconds": 15,
    "wait_seconds": 30,
    "default_task_seconds": 60
  }
}
