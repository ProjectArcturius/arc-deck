{
  "schema_version": 1,
  "runtime": {
    "kind": "dsh-sdk",
    "entry": "C:/dsh/lib/bin.js",
    "version": "0.2.1-alpha.2",
    "profile": "sdk"
  },
  "state_root": "C:/arc-deck-state",
  "authorization": {
    "workspace": "C:/work/project",
    "profile": "workspace-readonly",
    "read_paths": ["."],
    "network": false,
    "allow_commit": false,
    "allow_push": false,
    "allowed_agents": ["echo", "build", "plan"]
  },
  "agents": {
    "dir": "C:/arc-deck/agents",
    "prompts_dir": "C:/arc-deck/prompts"
  },
  "model": {
    "provider": "deepseek-official",
    "model": "deepseek-flash"
  },
  "env": {
    "ARC_DECK_LOG": "info"
  },
  "timeouts": {
    "initialize_seconds": 120,
    "prompt_seconds": 30,
    "wait_seconds": 600,
    "default_task_seconds": 900
  }
}
