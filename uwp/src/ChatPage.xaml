<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArcDeck.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ArcDeck"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
          两条消息模板：自己的靠右、对方的靠左。
          用 DataTemplateSelector 分派是 UWP 的标准做法 —— 比在单一模板里
          写一堆绑定转换器清楚得多。
        -->
        <DataTemplate x:Key="MineTemplate" x:DataType="local:ChatMessage">
            <Grid HorizontalAlignment="Right" MaxWidth="520" Margin="48,4,24,4">
                <Border
                    Background="{ThemeResource SystemControlBackgroundAccentBrush}"
                    CornerRadius="8"
                    Padding="14,10">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="{x:Bind Author}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemControlForegroundChromeWhiteBrush}"
                            Opacity="0.85" />
                        <TextBlock
                            Text="{x:Bind Text}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource SystemControlForegroundChromeWhiteBrush}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TheirsTemplate" x:DataType="local:ChatMessage">
            <Grid HorizontalAlignment="Left" MaxWidth="640" Margin="24,4,48,4">
                <StackPanel Spacing="6">
                    <TextBlock
                        Text="{x:Bind Author}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Border
                        Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                        CornerRadius="8"
                        Padding="14,10">
                        <TextBlock
                            Text="{x:Bind Text}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </Border>

                    <!-- 工具调用卡片：非空才显示。
                         用默认的 OneTime 绑定 —— HasTool 在模板加载后不会变，
                         声明 OneWay 会触发 WMC1506（没有变更通知可依赖）。 -->
                    <Border
                        Visibility="{x:Bind HasTool}"
                        Background="{ThemeResource SystemControlBackgroundAltMediumLowBrush}"
                        BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE756;" FontSize="14"
                                          Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                                <TextBlock Text="{x:Bind ToolName}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ToolDetail}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <Border Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                                    CornerRadius="6"
                                    Padding="12,10">
                                <TextBlock Text="{x:Bind ToolOutput}"
                                           FontFamily="Consolas"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <local:MessageTemplateSelector
            x:Key="MessageSelector"
            Mine="{StaticResource MineTemplate}"
            Theirs="{StaticResource TheirsTemplate}" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
          顶部用 CommandBar —— UWP 的标准命令栏。返回键是它的成员，
          而不是自己摆一个按钮。CommandBar 自带溢出菜单、键盘提示与无障碍。
        -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" IsOpen="False">
            <AppBarButton Icon="Back" Label="返回" Click="OnBackClick" />
            <AppBarButton x:Name="FavoriteButton" Icon="Favorite" Label="收藏" Click="OnFavoriteClick" />
            <AppBarSeparator />
            <AppBarButton Icon="Copy" Label="复制路径" Click="OnCopyPathClick" />
            <CommandBar.Content>
                <StackPanel Margin="0,8,0,10" Spacing="2">
                    <TextBlock
                        x:Name="TitleText"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1" />
                    <TextBlock
                        x:Name="MetaText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>

        <!-- 消息列表 -->
        <ListView
            x:Name="MessageList"
            Grid.Row="1"
            SelectionMode="None"
            IsItemClickEnabled="False"
            ItemTemplateSelector="{StaticResource MessageSelector}"
            Padding="0,8,0,8"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <!--
                      对话气泡不该有行的 hover/选中反馈 —— 它不是可选中的列表项。
                      只关掉这两项，其余（虚拟化、无障碍容器）保留。
                    -->
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!--
          输入区。

          用 TextBox + 发送按钮，键盘 Enter 提交。这里是验证中文输入法通路的地方 ——
          UWP 的 TextBox 自带完整 IME 支持（组合、候选窗、提交），无需任何处理。
        -->
        <Grid Grid.Row="2" Padding="16,12" ColumnSpacing="10"
              Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="Composer"
                Grid.Column="0"
                PlaceholderText="输入消息（支持中文输入法）"
                AcceptsReturn="False"
                MaxLength="4000"
                KeyDown="OnComposerKeyDown" />

            <Button
                Grid.Column="1"
                Content="发送"
                Style="{StaticResource AccentButtonStyle}"
                Click="OnSendClick" />
        </Grid>
    </Grid>
</Page>
