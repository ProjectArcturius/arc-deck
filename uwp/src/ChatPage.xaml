<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArcDeck.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ArcDeck"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
          内容块模板。

          一条消息由若干块组成（段落 / 代码 / 工具调用），用 DataTemplateSelector
          分派 —— 比在单一模板里堆可见性判断清楚，也让每块的排版独立可调。
        -->

        <!--
          段落。

          用附加属性 `local:Markdown.Text` 而不是 `Text="{x:Bind Text}"`：
          消息原文里本来就有 Markdown（`**转发给 App**` 之类），当纯文本显示时
          界面上会直接出现一串星号。`TextBlock.Inlines` 不能直接 x:Bind，
          所以由附加属性在回调里填充 —— 见 Controls/Markdown.cs。

          ── 为什么是 RichTextBlock 而不是 TextBlock ──────────────────

          `TextBlock.Inlines` 只接受 `Inline`；段落级的间距要靠 `Paragraph`，
          而那是 `RichTextBlock` 才有的。用 TextBlock 的话每个块级元素都被迫
          拼成一行，标题/列表/引用的间距就没法表达。实测编译报错：
          「无法从 Paragraph 转换为 Inline」。

          RichTextBlock 同样支持选中复制。
        -->
        <DataTemplate x:Key="ParaTemplate" x:DataType="local:ChatBlock">
            <RichTextBlock
                local:Markdown.Text="{x:Bind Text}"
                TextWrapping="Wrap"
                IsTextSelectionEnabled="True"
                Margin="0,0,0,8" />
        </DataTemplate>

        <!--
          代码块：等宽 + 语言标签。

          ── 两处踩过的坑 ──────────────────────────────────────────────

          1) 底色踩过两次坑，都是"半透明"引起的：

             先用 SystemControlBackgroundBaseMediumLowBrush —— 那是 40% 白，
             垫在深色页面上变成浅灰，浅色文字压上去几乎读不出来。

             再换 SystemControlBackgroundBaseLowBrush —— 20% 白，好一些但仍然
             是"页面深色 + 白"的中灰，对比度依旧不够。

             正解是用**不透明**的深灰 SystemChromeMediumLowColor（#FF2B2B2B），
             它自己带 Alpha，不依赖底下是什么。代码块本该是"凹进去的表面"，
             这个语义也对。

          2) 边框设 Stretch 会让短代码也撑满整行，看起来像一条横幅。代码块
             应该贴合内容，所以用 Left。
        -->
        <DataTemplate x:Key="CodeTemplate" x:DataType="local:ChatBlock">
            <Border
                HorizontalAlignment="Left"
                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="0"
                Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Visibility="{x:Bind HasLanguage}"
                        Text="{x:Bind Language}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Margin="12,8,12,0" />

                    <!-- 代码不折行，折了就没法读；超出部分横向滚动 -->
                    <ScrollViewer
                        Grid.Row="1"
                        MaxWidth="640"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        Padding="12,8,12,10">
                        <TextBlock
                            Text="{x:Bind Text}"
                            FontFamily="Consolas"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="NoWrap"
                            IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 工具调用：可展开看输出 -->
        <DataTemplate x:Key="ToolTemplate" x:DataType="local:ChatBlock">
            <muxc:Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Margin="0,0,0,8">
                <muxc:Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- 同 WorkspacesPage：用枚举名而非码点 -->
                        <SymbolIcon Symbol="Setting"
                                    Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                        <TextBlock Text="{x:Bind ToolHeader}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                </muxc:Expander.Header>

                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    Padding="0,4,0,8">
                    <TextBlock
                        Text="{x:Bind Text}"
                        FontFamily="Consolas"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="NoWrap"
                        IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </muxc:Expander>
        </DataTemplate>

        <local:BlockTemplateSelector
            x:Key="BlockSelector"
            Para="{StaticResource ParaTemplate}"
            Code="{StaticResource CodeTemplate}"
            Tool="{StaticResource ToolTemplate}" />

        <!--
          消息模板。

          自己的：靠右 + 强调色底 —— 唯一用底色的消息，一眼分得清。
          对方的：靠左 + **无底色**。早先给助手消息也铺了一层灰底，结果是
          灰色气泡里再套灰色的代码块与工具卡，嵌套两层同色，看起来像排版事故。
          助手消息本来就是页面主体，不需要底色来强调。
        -->
        <DataTemplate x:Key="MineTemplate" x:DataType="local:ChatMessage">
            <Grid HorizontalAlignment="Right" MaxWidth="560" Margin="56,6,20,6">
                <Border
                    Background="{ThemeResource SystemControlBackgroundAccentBrush}"
                    CornerRadius="0"
                    Padding="14,10,10,10">
                    <StackPanel>
                        <ItemsControl
                            ItemsSource="{x:Bind Blocks}"
                            ItemTemplateSelector="{StaticResource BlockSelector}" />
                        <!--
                          元信息在强调色底上。用 ChromeDisabledLow（实测为明确的
                          浅灰 #FF858585 / #FF7A7A7A），不用 ChromeWhite + Opacity ——
                          后者在实机上是暗灰，压在蓝色气泡上读不出来。
                        -->
                        <TextBlock
                            Text="{x:Bind Meta}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemControlForegroundChromeDisabledLowBrush}"
                            HorizontalAlignment="Right"
                            Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TheirsTemplate" x:DataType="local:ChatMessage">
            <Grid HorizontalAlignment="Left" MaxWidth="760" Margin="20,8,56,8">
                <StackPanel>
                    <!-- 助手的元信息在上方，像一条注解，而不是塞进气泡里 -->
                    <TextBlock
                        Text="{x:Bind Meta}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Margin="0,0,0,6" />
                    <ItemsControl
                        ItemsSource="{x:Bind Blocks}"
                        ItemTemplateSelector="{StaticResource BlockSelector}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <local:MessageTemplateSelector
            x:Key="MessageSelector"
            Mine="{StaticResource MineTemplate}"
            Theirs="{StaticResource TheirsTemplate}" />
    </Page.Resources>

    <!--
      ── 这里曾经记着一条「输入区落在窗口外」的缺陷，它是**量测错误** ────

      当时的数字（`uwp/tools/shot/Geometry.ps1`）看起来无懈可击：

          实际窗口   size=1550x830   dpi=120
          UIA 窗口   1938x1038
          输入框     421,964  1403x41   ← 964+41 = 1005 > 830

      错在两个数字**不在同一个坐标空间**：`GetWindowRect` 在未声明 DPI 感知的
      进程里返回按 96 DPI 虚拟化过的值，而 UIA 的 `BoundingRectangle` 是物理像素。
      两者差 1.25 倍（正是缩放比），相减就凭空造出「多出 200px」。

      实情：窗口 1938x1038 物理像素 = 1550x830 DIP，输入框底边 1005 在窗口底边
      1029 之内。**布局本来是对的**，当初「试过四种办法都无效」也正因为它没错。

      量坐标请用 `uwp/tools/shot/Layout.ps1`（先 SetProcessDpiAwarenessContext）。
      详见 AGENTS.md U13。
    -->
    <!--
      布局：Auto（工具条）/ Auto（标题）/ *（消息列表）/ Auto（输入区）。
      `*` 行吃满剩余高度 —— 输入区因此永远贴在窗口底部，不依赖窗口尺寸。
    -->
    <Grid
        VerticalAlignment="Stretch"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
          操作条。

          ── 为什么这不是 CommandBar ──────────────────────────────────────

          原来这里是 `CommandBar`，标题放在它的 `CommandBar.Content` 里。
          实机坐标：标题在 x=715 起，而「复制路径 / 重载」在 x=1359 / 1444 ——
          窗口当时只到 1278，也就是说**按钮落在窗口外，点不到**。
          会话页试过同样的结构，两种配置都会把命令按钮排到窗口外
          （x=1599..1920 / x=1689..，窗口 1550 宽），用 Region.ps1 量过那两处
          亮像素数为 0，确认不是抓图伪影。

          所以两页统一改成行为确定的写法：一排按钮 + 一个带 MenuFlyout 的溢出
          按钮，标题另起一行。每个按钮都有 Label，键盘与无障碍语义都不缺。
        -->
        <!--
          每个纯图标按钮都必须显式设 AutomationProperties.Name。
          `Button` + `SymbolIcon` 不带任何文本，`ToolTipService.ToolTip` 也**不构成**
          无障碍名称 —— 实测 Narrator 与 UI Automation 都读不到它（Uia.ps1 -Invoke
          "返回" 报 element not found 就是这个原因）。没有名字屏幕阅读器只会念
          「按钮」，用户不知道是哪个。
        -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,10,20,0" Spacing="8">
            <Button Click="OnBackClick"
                    AutomationProperties.Name="返回会话列表"
                    ToolTipService.ToolTip="返回会话列表">
                <SymbolIcon Symbol="Back" />
            </Button>

            <Button x:Name="FavoriteButton" Click="OnFavoriteClick"
                    AutomationProperties.Name="收藏"
                    ToolTipService.ToolTip="收藏">
                <!--
                  用 FontIcon 而不是 SymbolIcon：Symbol 枚举里没有"实心星"
                  （`Symbol.FavoriteFill` 不存在，编译报 CS0117），而收藏状态
                  要靠图标区分。
                  FontFamily 显式绑 SymbolThemeFontFamily，码点才会跟着系统实际
                  使用的那套图标字体解析 —— 写死字体名会在另一套字体下指错图。
                -->
                <FontIcon
                    x:Name="FavoriteIcon"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    Glyph="&#xE734;" />
            </Button>

            <Button Click="OnCopyPathClick"
                    AutomationProperties.Name="复制工作区路径"
                    ToolTipService.ToolTip="复制工作区路径">
                <SymbolIcon Symbol="Copy" />
            </Button>

            <Button Click="OnReloadClick"
                    AutomationProperties.Name="重载会话"
                    ToolTipService.ToolTip="重载会话">
                <SymbolIcon Symbol="Refresh" />
            </Button>
        </StackPanel>

        <!--
          标题区。原先挤在命令栏的 Content 里，位置由命令栏模板决定；
          独立成行后它的位置只取决于本页的排版，不会再被工具条的宽度牵连。
        -->
        <StackPanel Grid.Row="1" Margin="20,8,20,10" Spacing="2">
            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                MaxLines="1" />
            <TextBlock
                x:Name="MetaText"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis"
                MaxLines="1" />
        </StackPanel>

        <!-- 消息列表 -->
        <ListView
            x:Name="MessageList"
            Grid.Row="2"
            SelectionMode="None"
            IsItemClickEnabled="False"
            ItemTemplateSelector="{StaticResource MessageSelector}"
            Padding="0,8,0,8"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <!--
                      对话气泡不是可选中项 —— 关掉行的 hover/选中反馈与最小高度。
                      其余（虚拟化、无障碍容器）保留。
                    -->
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- 输入区。UWP 的 TextBox 自带完整 IME 支持，中文输入无需任何处理。 -->
        <Grid Grid.Row="3" Padding="16,12" ColumnSpacing="10"
              Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="Composer"
                Grid.Column="0"
                PlaceholderText="输入消息（支持中文输入法）"
                AcceptsReturn="False"
                MaxLength="4000"
                KeyDown="OnComposerKeyDown" />

            <Button
                Grid.Column="1"
                Content="发送"
                Style="{StaticResource AccentButtonStyle}"
                Click="OnSendClick" />
        </Grid>
    </Grid>
</Page>
