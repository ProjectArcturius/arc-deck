<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap mp desktop rescap">

  <!--
    版本号在开发期要随每次改动递增。
    原因：同版本号但内容不同的 MSIX 会被部署引擎拒装（0x80073CFB），
    提示「提高版本号或卸载已安装的包」。每次改动都卸载重装会连
    LocalSettings 一起清掉，于是「设置是否持久化」这类测试永远测不出来 ——
    必须靠提版本覆盖安装，才能保住应用数据。
  -->
  <Identity
    Name="ProjectArcturius.ArcDeck"
    Publisher="CN=ProjectArcturius"
    Version="0.1.18.0" />

  <!-- PhoneIdentity 在桌面清单里也是必需元素 —— 缺它报 APPX1673。 -->
  <mp:PhoneIdentity PhoneProductId="7c4e1a92-5d38-4f61-b0a7-2e9c8d5f3b14"
                    PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Saiku Deck</DisplayName>
    <PublisherDisplayName>Takahashi Rinta</PublisherDisplayName>
    <!-- Properties/Logo 走 **StoreLogo** 校验，规范要求恰好 50×50。 -->
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal"
                        MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="ArcDeck.App">
      <uap:VisualElements
        DisplayName="Saiku Deck"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="DeepSeek Harness 的 Windows 客户端"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="transparent" />
      </uap:VisualElements>
      <!--
        完整信任伴随进程（AGENTS P1）：UWP 自己起不了 dsh、读不到 %APPDATA%，
        执行与文件访问交给 Host\ArcDeck.Host.exe。

        AppService 的 provider 必须是**包自己**，所以这里声明服务；
        伴随进程是 client，它用自己的包身份 OpenAsync 连回来。
      -->
      <Extensions>
        <uap:Extension Category="windows.appService">
          <uap:AppService Name="arcdeck.host" />
        </uap:Extension>
        <desktop:Extension Category="windows.fullTrustProcess"
                           Executable="Host\ArcDeck.Host.exe" />
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- 拉起包内完整信任进程需要的能力（受限制能力，侧载可安装）。 -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
