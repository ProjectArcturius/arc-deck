<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <Identity
    Name="ProjectArcturius.ArcDeck"
    Publisher="CN=ProjectArcturius"
    Version="0.1.0.0" />

  <!-- PhoneIdentity 在桌面清单里也是必需元素 —— 缺它报 APPX1673。 -->
  <mp:PhoneIdentity PhoneProductId="7c4e1a92-5d38-4f61-b0a7-2e9c8d5f3b14"
                    PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Arc Deck</DisplayName>
    <PublisherDisplayName>Takahashi Rinta</PublisherDisplayName>
    <!-- Properties/Logo 走 **StoreLogo** 校验，规范要求恰好 50×50。 -->
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal"
                        MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="ArcDeck.App">
      <uap:VisualElements
        DisplayName="Arc Deck"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="DeepSeek Harness 的 Windows 客户端"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="transparent" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
