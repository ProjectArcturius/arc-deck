<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArcDeck.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ArcDeck"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      工具页。

      原先这一页是 WinUI 2 的**控件展品**（InfoBar / NumberBox / RatingControl /
      PipsPager / Expander / BreadcrumbBar 各摆一个），那不是客户端该有的页面 ——
      用户来看的是「模型能用哪些工具、哪些会打断我」，不是控件目录。

      改成主从视图：左边筛选后的清单，右边选中工具的详情。
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 窄窗时右栏会被挤掉，所以左栏给固定宽度而不是比例 -->
            <ColumnDefinition Width="360" MinWidth="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── 左：清单 ──────────────────────────────────────────── -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="24,24,24,12" Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="工具" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        x:Name="CountText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <AutoSuggestBox
                    x:Name="ToolSearch"
                    QueryIcon="Find"
                    PlaceholderText="搜索工具名或说明"
                    TextChanged="OnSearchTextChanged" />
            </StackPanel>

            <ListView
                x:Name="ToolList"
                Grid.Row="1"
                Margin="8,0,8,8"
                SelectionMode="Single"
                SelectionChanged="OnToolSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ToolInfo">
                        <StackPanel Padding="4,8" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    Text="{x:Bind Name}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    FontFamily="Consolas" />
                                <!-- 徽标只在需要时占位 -->
                                <Border
                                    Background="{ThemeResource SystemControlBackgroundAccentBrush}"
                                    Padding="6,1,6,1"
                                    Visibility="{x:Bind RequiresApproval}"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Text="需确认"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource SystemControlForegroundChromeWhiteBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind Summary}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                MaxLines="2" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ── 右：详情 ──────────────────────────────────────────── -->
        <ScrollViewer Grid.Column="1" Padding="24,24,24,32"
                      BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                      BorderThickness="1,0,0,0">
            <StackPanel x:Name="DetailPane" Spacing="16" MaxWidth="720"
                        HorizontalAlignment="Left">

                <TextBlock
                    x:Name="DetailPlaceholder"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="从左侧选一个工具看详情。"
                    TextWrapping="Wrap" />

                <StackPanel x:Name="DetailContent" Spacing="16" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="DetailName"
                            Style="{StaticResource TitleTextBlockStyle}"
                            FontFamily="Consolas" />
                        <TextBlock
                            x:Name="DetailSummary"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--
                      参数与来源用 DescriptionList 式的排布。
                      StackPanel + 两列 Grid 而不是 Grid 的 Auto 列 —— 后者在
                      标签长度不一时会对不齐，这里两列都是固定比例。
                    -->
                    <Grid ColumnSpacing="16" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="参数"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="DetailSignature" Grid.Row="0" Grid.Column="1"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="来源"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="DetailOrigin" Grid.Row="1" Grid.Column="1"
                                   Style="{StaticResource CaptionTextBlockStyle}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="审批"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="DetailApproval" Grid.Row="2" Grid.Column="1"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <StackPanel x:Name="DetailNotes" Spacing="8" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
