<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArcDeck.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 设置分组共用样式（UWP 惯例） -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="24,24,24,32">
        <StackPanel Spacing="28" MaxWidth="900" HorizontalAlignment="Stretch">

            <StackPanel Spacing="4">
                <TextBlock Text="工具" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="WinUI 2 提供的控件一览" />
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="状态与提示" Style="{StaticResource SectionHeaderStyle}" />

                <muxc:InfoBar
                    IsOpen="True"
                    Severity="Informational"
                    Title="InfoBar"
                    Message="WinUI 2 提供的横幅提示控件。" />

                <muxc:InfoBar
                    IsOpen="True"
                    Severity="Success"
                    Title="成功"
                    Message="Severity 决定图标与配色，跟系统主题走。" />
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="数值与选项" Style="{StaticResource SectionHeaderStyle}" />

                <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Bottom">
                    <!-- NumberBox 自带 Header；RatingControl / PipsPager 没有，
                         需要自己给标签 —— 这是 WinUI 2 控件间的属性差异。 -->
                    <muxc:NumberBox
                        x:Name="NumberInput"
                        Header="数值"
                        Value="42"
                        SpinButtonPlacementMode="Compact"
                        Width="180" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="评分" Style="{StaticResource CaptionTextBlockStyle}" />
                        <muxc:RatingControl Value="3" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="分页" Style="{StaticResource CaptionTextBlockStyle}" />
                        <muxc:PipsPager
                            x:Name="Pager"
                            NumberOfPages="5"
                            SelectedPageIndex="1" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="容器与命令" Style="{StaticResource SectionHeaderStyle}" />

                <muxc:Expander Header="Expander" HorizontalAlignment="Stretch" IsExpanded="True">
                    <StackPanel Spacing="8" Padding="0,8,0,8">
                        <TextBlock Text="可折叠容器。内容由平台排版决定间距。" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <muxc:DropDownButton Content="DropDownButton">
                                <muxc:DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="动作一" Icon="Copy" />
                                        <MenuFlyoutItem Text="动作二" Icon="Delete" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="动作三" />
                                    </MenuFlyout>
                                </muxc:DropDownButton.Flyout>
                            </muxc:DropDownButton>

                            <muxc:SplitButton Content="SplitButton">
                                <muxc:SplitButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="选项一" />
                                        <MenuFlyoutItem Text="选项二" />
                                    </MenuFlyout>
                                </muxc:SplitButton.Flyout>
                            </muxc:SplitButton>
                        </StackPanel>
                    </StackPanel>
                </muxc:Expander>

                <muxc:BreadcrumbBar x:Name="Breadcrumb" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="对话框与浮层" Style="{StaticResource SectionHeaderStyle}" />

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="ContentDialog" Click="OnOpenDialog" />
                    <Button Content="TeachingTip" Click="OnOpenTeachingTip" />
                    <Button Content="Flyout">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Spacing="8" MaxWidth="280">
                                    <TextBlock Text="Flyout" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="浮层内容。" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
