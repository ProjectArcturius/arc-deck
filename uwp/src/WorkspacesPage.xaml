<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArcDeck.WorkspacesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,24,24,12" Spacing="4">
            <TextBlock Text="工作区" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="会话按工作区归类" />
        </StackPanel>

        <!-- 分组列表：ISupportIncrementalLoading / CollectionViewSource 都可，
             这里用最简单的分组 ListView —— 平台自带粘性分组头。 -->
        <ListView
            x:Name="WorkspaceList"
            Grid.Row="1"
            Margin="8,0,8,8"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnWorkspaceClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="14" Padding="4,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--
                          用 SymbolIcon + 枚举名，不用 FontIcon + 码点。
                          码点在不同图标字体里语义不同（U+E8B7 在 Fluent 里是文件夹，
                          在 MDL2 里不是），枚举名由框架解析，换字体也不会指错图。
                        -->
                        <SymbolIcon Grid.Column="0" Symbol="Folder"
                                    Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                                    VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding Path}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{Binding Summary}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{Binding Count}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
