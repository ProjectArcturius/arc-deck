<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArcDeck.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="24,24,24,32">
        <StackPanel Spacing="32" MaxWidth="900" HorizontalAlignment="Stretch">

            <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Spacing="8">
                <TextBlock Text="外观" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="主题、强调色与圆角全部由 Windows 决定。本应用不做任何覆盖 —— 你在系统设置里改了主题，这里就跟着变。" />

                <StackPanel Spacing="4">
                    <TextBlock Text="应用模式" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <RadioButton x:Name="ThemeSystem" Content="跟随系统" GroupName="Theme"
                                 IsChecked="True" Checked="OnThemeChecked" Tag="default" />
                    <RadioButton x:Name="ThemeLight" Content="浅色" GroupName="Theme"
                                 Checked="OnThemeChecked" Tag="light" />
                    <RadioButton x:Name="ThemeDark" Content="深色" GroupName="Theme"
                                 Checked="OnThemeChecked" Tag="dark" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="伴随进程" Style="{StaticResource SectionHeaderStyle}" />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="UWP 跑在 AppContainer 里：起不了 dsh 子进程，也读不到包外路径。这是沙箱的结构限制，不是缺功能。执行与文件访问交给包内一个完整信任的伴随进程，界面只通过 AppService 向它发请求。" />

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="HostCheckButton" Content="拉起并检查" Click="OnHostCheck" />
                    <TextBlock
                        x:Name="HostStateText"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <TextBlock
                    x:Name="HostResultText"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    IsTextSelectionEnabled="True" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="关于" Style="{StaticResource SectionHeaderStyle}" />
                <StackPanel Spacing="4">
                    <TextBlock x:Name="VersionText" Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="DeepSeek Harness 的 Windows 客户端，用微软自家的接口与套件构建。" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
