<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArcDeck.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ArcDeck"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面标题区。用平台排版刻度（TitleTextBlockStyle 等），不自定义字号。 -->
        <StackPanel Grid.Row="0" Margin="24,24,24,12" Spacing="4">
            <TextBlock Text="会话" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Name="CountText"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!--
          会话列表。

          ListView + ItemTemplate 是 UWP 的标准做法：它自带虚拟化、选中态、
          键盘导航、无障碍语义与触摸手势。用默认样式，不重写模板 ——
          行高、留白、hover 反馈都跟系统走。
        -->
        <ListView
            x:Name="SessionList"
            Grid.Row="1"
            Margin="8,0,8,8"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnSessionClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:Session">
                    <Grid ColumnSpacing="14" Padding="4,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 头像：ListViewItemPresenter 的对齐由模板 padding 决定，不额外加装饰 -->
                        <Border
                            Grid.Column="0"
                            Width="40"
                            Height="40"
                            CornerRadius="4"
                            Background="{ThemeResource SystemControlBackgroundAccentBrush}"
                            VerticalAlignment="Top">
                            <TextBlock
                                Text="{x:Bind Initial}"
                                Foreground="{ThemeResource SystemControlForegroundChromeWhiteBrush}"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                Text="{x:Bind Title}"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                            <TextBlock
                                Text="{x:Bind Preview}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="2"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="{x:Bind Subtitle}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind UpdatedAt}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            VerticalAlignment="Top" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
