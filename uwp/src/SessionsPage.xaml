<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArcDeck.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ArcDeck"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
          行容器样式。

          只做对齐与挂右键菜单，不碰外观 —— 平台模板里的虚拟化、选中态、
          键盘导航、无障碍全靠它，重写就得自己维护。
        -->
        <Style x:Key="SessionRowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ContextFlyout" Value="{StaticResource RowMenu}" />
        </Style>

        <!--
          行右键菜单。放在 Resource 里而不是 ListView 的行模板里 ——
          后者要为每一行实例化一份 MenuFlyout，长列表下是纯浪费。
        -->
        <MenuFlyout x:Key="RowMenu">
            <MenuFlyoutItem Text="打开" Click="OnOpenClick">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="OpenFile" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="重命名…" Click="OnRenameClick">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Rename" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <!--
              没有 x:Name：操作条里已有一个同名的 PinMenuItem，XAML 不允许
              两个元素共用同一个名称。两份菜单走同一个 OnPinClick，
              文案同步只更新操作条那一份即可。
            -->
            <MenuFlyoutItem Text="置顶" Click="OnPinClick">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Pin" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="复制工作区路径" Click="OnCopyPathClick">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Copy" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="删除" Click="OnDeleteClick">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Delete" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <!--
      布局：导航栏（固定高）+ 标题区（固定高）+ 列表（占满剩余）。

      先前是「标题与列表同在 Grid.Row=1，靠 ListView 的 Margin 让出标题的位置」
      —— 标题靠 Canvas.ZIndex 浮在列表上面。能显示，但标题的实际位置由 margin
      凑出来，命令栏一旦换高就会错位。改成常规的 StackPanel + 星号行。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
          操作条。

          ── 为什么不用 CommandBar ────────────────────────────────────────

          试过 CommandBar，两种配置都失败：

          1. 把标题放进 `CommandBar.Content` —— 命令按钮被排到 x=1599..1920，
             而窗口只有 1550 宽，即完全在窗口外。截图上是彻底看不见，
             但 UIA 仍报 `visible`，所以肉眼与自动化都容易误判
          2. 去掉 `Content`、只留 PrimaryCommands —— 仍然被排到 x=1689 起的
             窗口外。可见这不是 Content 宽度导致的，而是这个布局下
             CommandBar 内部对命令条与溢出按钮的排布出了问题

          用 Region.ps1 量过：那两处区域的亮像素数都是 0，确认不是抓图伪影。

          所以改成平台里另一个**行为确定**的写法：一排按钮 + 一个带 MenuFlyout
          的溢出按钮。动作与键盘可达性都不缺 —— 每个按钮都有 Label，
          MenuFlyout 本身也有键盘导航与无障碍语义。

          需要 `DefaultLabelPosition` 之类的行为时再回到 CommandBar。
        -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,10,20,0" Spacing="8">
            <Button Click="OnNewSessionClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="新会话" />
                </StackPanel>
            </Button>

            <Button Click="OnRefreshClick" ToolTipService.ToolTip="重新读取会话列表">
                <SymbolIcon Symbol="Refresh" />
            </Button>

            <Button Click="OnSelectAllClick" ToolTipService.ToolTip="全选 / 取消全选">
                <SymbolIcon Symbol="SelectAll" />
            </Button>

            <!-- 其余动作收进菜单。用 Button + MenuFlyout 而不是 CommandBar 的
                 SecondaryCommands —— 后者正是上面那个排布问题的来源。 -->
            <Button ToolTipService.ToolTip="更多操作">
                <SymbolIcon Symbol="More" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="RenameMenuItem" Text="重命名…" Click="OnRenameClick">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Rename" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="PinMenuItem" Text="置顶" Click="OnPinClick">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Pin" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="复制工作区路径" Click="OnCopyPathClick">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Copy" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="删除" Click="OnDeleteClick">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Delete" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <!-- 标题区。用平台排版刻度（TitleTextBlockStyle 等），不自定义字号。 -->
        <StackPanel Grid.Row="1" Margin="24,8,24,12" Spacing="4">
            <TextBlock Text="会话" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Name="CountText"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!--
          会话列表。

          ListView + ItemTemplate 是 UWP 的标准做法：它自带虚拟化、选中态、
          键盘导航、无障碍语义与触摸手势。用默认样式，不重写模板 ——
          行高、留白、hover 反馈都跟系统走。

          SelectionMode="Extended" 而 IsItemClickEnabled="True" 是刻意的组合：
          单击进会话（聊天应用的惯例），Ctrl/Shift 多选用于批量操作。
        -->
        <local:SessionListView
            x:Name="SessionList"
            Grid.Row="2"
            Margin="8,0,8,8"
            SelectionMode="Extended"
            IsItemClickEnabled="True"
            ItemClick="OnSessionClick"
            SelectionChanged="OnSelectionChanged">
            <ListView.ItemContainerStyle>
                <StaticResource ResourceKey="SessionRowStyle" />
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:Session">
                    <Grid ColumnSpacing="14" Padding="4,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="40"
                            Height="40"
                            CornerRadius="0"
                            Background="{ThemeResource SystemControlBackgroundAccentBrush}"
                            VerticalAlignment="Top">
                            <TextBlock
                                Text="{x:Bind Initial}"
                                Foreground="{ThemeResource SystemControlForegroundChromeWhiteBrush}"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <!-- 置顶标记：只在置顶时占位，不做恒占位的空图标 -->
                                <SymbolIcon
                                    Symbol="Pin"
                                    Visibility="{x:Bind IsPinned, Mode=OneWay}"
                                    Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                                <TextBlock
                                    Text="{x:Bind Title}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="1" />
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind Preview, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="2"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="{x:Bind Subtitle}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind UpdatedAtText}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            VerticalAlignment="Top" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </local:SessionListView>

        <!--
          空状态。ListView 为空时铺一句说明 —— 否则删光会话后是一片纯空白，
          看起来像加载失败。
        -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            Margin="24"
            Spacing="8"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <SymbolIcon Symbol="Comment" HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="没有会话" Style="{StaticResource BodyStrongTextBlockStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyHintText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
