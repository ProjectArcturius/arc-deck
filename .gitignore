# ── Rust（kanesumi 版本）────────────────────────────────
/target
**/*.rs.bk
*.pdb

# ── UWP（uwp 版本，走 MSBuild）──────────────────────────
# 两个实现的产物都叫 bin/obj，统一在根忽略即可。
bin/
obj/
AppPackages/
*.appxupload
*.appxsym
*.user
*.suo

# 图标**入库**：Package.appxmanifest 引用它们，忽略会导致干净克隆后构建失败。
# 图标是设计资产，不用构建脚本合成（已移除 tools/make-icons 的理由之一）。

# 签名用的测试证书 —— 由 tools/deploy-check 现场生成，不入库。
*.cer
*.pfx

# ── 本地运行产物 ────────────────────────────────────────
# 探针与 demo 的临时日志
/probe-out.log
/probe-err.log
/probe-sdk.log
/probe-cli*.log
/probe-load*.log
/probe-check*.log
/probe-verify*.log
# harness web 那条路的探针输出（换票、follow、Remote 层各方法）
/probe-harness*.log
/demo-out.log
/demo-err.log

# 探针抓取的窗口截图（一次性检视用）
#
# 忽略的是**检视用的临时截图**，不是设计资产 —— 图标是资产（见上），
# 临时截图不是。这一轮为了核对界面产生过几十张，规则松一点省得每次手删。
# 用 uwp/tools/shot/ 下的脚本抓图时，输出请落在仓根。
/shot*.png
/shot*.bmp
/*-shot.png
/*.png

# ── 编辑器 / 系统 ───────────────────────────────────────
.vscode/
.idea/
.vs/
*.swp
Thumbs.db
desktop.ini

# 提交信息临时文件（写中文正文用，避免 heredoc 在 PowerShell 里的转义问题）
/.git-commit-msg.tmp

# 提交信息临时文件
/.commitmsg.tmp

# 提交信息临时文件
/.commitmsg*.tmp
