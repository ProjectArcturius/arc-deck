# 本地参考仓库 —— 不将上游检出及其产物带入 Saiku 的提交。
/REFS/

# ── Rust（kanesumi 版本）────────────────────────────────
/target
**/*.rs.bk
*.pdb

# ── UWP（uwp 版本，走 MSBuild）──────────────────────────
# .NET 的产物目录叫 bin/obj。**只在 .NET 树下忽略** —— 曾经写成全局的 `bin/`，
# 结果把 Rust 的 `src/bin/` 源码也吞了：kanesumi 的 arc-deck-demo 与 ime-probe 的
# 三个探针从未入库，干净克隆后整个 workspace 编不过（2026-10-14 推送前发现）。
/uwp/**/bin/
/uwp/**/obj/
/arc-deck-dsh/**/bin/
/arc-deck-dsh/**/obj/
AppPackages/
*.appxupload
*.appxsym
*.user
*.suo

# 图标**入库**：Package.appxmanifest 引用它们，忽略会导致干净克隆后构建失败。
# 图标是设计资产，不用构建脚本合成（已移除 tools/make-icons 的理由之一）。

# 签名用的测试证书 —— 由 tools/deploy-check 现场生成，不入库。
*.cer
*.pfx

# ── 本地运行产物 ────────────────────────────────────────
# worker 的离线验收会把结果写到工作目录（参 docs/PRODUCT_PLAN.md §10.2）。
# 状态目录落在 target/ 下，已经在上面忽略过了。
/result.json

# 探针与 demo 的临时日志
/probe-out.log
/probe-err.log
/probe-sdk.log
/probe-cli*.log
/probe-load*.log
/probe-check*.log
/probe-verify*.log
# harness web 那条路的探针输出（换票、follow、Remote 层各方法）
/probe-harness*.log
/demo-out.log
/demo-err.log

# 探针抓取的窗口截图（一次性检视用）
#
# 忽略的是**检视用的临时截图**，不是设计资产 —— 图标是资产（见上），
# 临时截图不是。这一轮为了核对界面产生过几十张，规则松一点省得每次手删。
# 用 uwp/tools/shot/ 下的脚本抓图时，输出请落在仓根。
/shot*.png
/shot*.bmp
/*-shot.png
/*.png

# ── 编辑器 / 系统 ───────────────────────────────────────
.vscode/
.idea/
.vs/
*.swp
Thumbs.db
desktop.ini

# 提交信息临时文件（写中文正文用，避免 heredoc 在 PowerShell 里的转义问题）
/.git-commit-msg.tmp

# 提交信息临时文件
/.commitmsg.tmp

# 提交信息临时文件
/.commitmsg*.tmp

# 完整信任伴随进程的发布产物（uwp/host/publish.ps1 生成，属于构建产物）
/uwp/src/Host/
